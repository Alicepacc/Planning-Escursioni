{
	// Servizio delle uscite di gruppo (ADR 0014). Nessun segreto qui: la chiave privata VAPID e
	// il token di pubblicazione stanno nei segreti di Cloudflare (wrangler secret put).
	"name": "cordata-uscite",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cordata-uscite",
			// da sostituire con l'id reale dopo `wrangler d1 create cordata-uscite`
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// origine della PWA (CORS) e dominio delle passkey (WebAuthn relying party)
		"APP_ORIGIN": "https://alicepacc.github.io",
		"RP_ID": "alicepacc.github.io",
		"RP_NAME": "Cordata"
	}
}
